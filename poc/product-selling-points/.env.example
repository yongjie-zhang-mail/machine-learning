# Qwen endpoint url
QWEN_ENDPOINT=your_qwen_endpoint_here
# Qwen API Key
QWEN_API_KEY=your_qwen_api_key_here
# Qwen model name (optional, default: qwen3.7-plus)
QWEN_MODEL=qwen3.7-plus
# Enable model thinking output (optional, default: true)
ENABLE_THINKING=true

# NOTE: 待处理的商品图片 URL（本品 + 竞品）不在此配置，
# 请复制 products.example.json 为 products.json 后填写。

